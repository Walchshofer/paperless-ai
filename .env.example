# paperless-ai Environment Configuration
#
# This project uses ./docker-compose.env (repo root) as the single source of truth.
#
# To generate the compatibility ./.env file for legacy docker-compose clients:
#   npm run env:sync
#
# To validate the generated .env file:
#   npm run env:validate
#
# See docs/ENV_DOTENV_MIGRATION.md for full migration details.
#
# Note: The .env file is auto-generated and git-ignored. Do not edit it directly.
# Edit docker-compose.env and re-run `npm run env:sync` instead.

# Metrics protection (internal-only by default). See docs/OBSERVABILITY_AND_TELEMETRY.md
METRICS_INTERNAL_ONLY=true
METRICS_ALLOWED_CIDRS=127.0.0.1,::1,172.18.0.0/16
TRUST_PROXY=false
