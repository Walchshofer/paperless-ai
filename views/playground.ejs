<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visual RAG Playground - Paperless-AI</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@700&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/dashboard.css">
    <style>
        .document-card {
            position: relative;
            transition: all 0.3s ease;
        }

        #messageArea {
            position: relative;
            z-index: 100;
        }

        /* Smooth transition for image inversion */
        img {
            transition: filter 0.3s ease;
        }

        /* GPU Preparing animation */
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Island container */
        .island-container {
            min-height: calc(100vh - 80px);
        }
    </style>
</head>
<body class="h-full" data-page="<%= vm.page || 'playground' %>">
    <button id="themeToggle" data-testid="theme-toggle" class="theme-toggle">
        <i class="fas fa-moon dark:fas fa-sun"></i>
    </button>

    <div class="layout-container">
        <button id="mobileMenuButton" data-testid="mobile-menu-button" class="mobile-menu-button">
            <i class="fas fa-bars"></i>
        </button>
        <!-- Sidebar -->
        <div id="sidebarOverlay" class="sidebar-overlay"></div>
        <aside class="sidebar">
            <%- include('partials/sidebar-nav', { active: 'playground' }) %>
        </aside>

        <!-- Main Content -->
        <main class="main-content p-4">
            <!-- PlaygroundIsland Anchor (ticket:017.4) -->
            <div
                data-island="playground-island"
                data-testid="playground-island"
                data-props='{"mode": "visual-debug", "collection": "visual_pages", "gpuState": "idle"}'
                class="island-container bg-white rounded-lg shadow-lg"
            ></div>

            <div
                data-island="visual-overlays-island"
                data-testid="visual-overlays-island"
                data-props='{"documentId": null, "images": [], "overlaysByImage": {}}'
                class="island-container hidden"
            ></div>
        </main>
    </div>

    <script src="/js/shared-utilities.js"></script>

    <!-- Island Runtime (ticket:017.4) -->
    <%- include('partials/island-loader') %>
</body>
</html>
