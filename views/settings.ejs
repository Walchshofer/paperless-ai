<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - Paperless-AI</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/settings.css">
    <style>
        /* Settings page specific styles */
        .settings-container {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 1.5rem;
            padding: 1.5rem;
            min-height: calc(100vh - 80px);
        }

        @media (max-width: 768px) {
            .settings-container {
                grid-template-columns: 1fr;
            }
        }

        /* Island loading state */
        [data-island]:empty::before {
            content: '';
            display: block;
            height: 100px;
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: 8px;
        }

        [data-theme="dark"] [data-island]:empty::before {
            background: linear-gradient(90deg, #374151 25%, #4b5563 50%, #374151 75%);
            background-size: 200% 100%;
        }

        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }

        /* Dark mode header fixes */
        [data-theme="dark"] .content-header {
            background-color: var(--bg-secondary);
            color: var(--text-primary);
        }

        [data-theme="dark"] #apiKeyContainer {
            background-color: var(--bg-secondary);
            color: var(--text-primary);
        }
    </style>
</head>
<body class="h-full" data-page="<%= vm.page %>">
    <button id="themeToggle" data-testid="theme-toggle" class="theme-toggle">
        <i class="fas fa-moon dark:fas fa-sun"></i>
    </button>

    <div class="layout-container">
        <button id="mobileMenuButton" data-testid="mobile-menu-button" class="mobile-menu-button">
            <i class="fas fa-bars"></i>
        </button>

        <!-- Sidebar Overlay -->
        <div id="sidebarOverlay" class="sidebar-overlay"></div>

        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="/favicon.ico" class="no-invert" alt="Paperless AI Logo" style="height: 60px;">
                <h1 class="brand-title">Paperless-AI<small style="display: block;"><%= vm.version %></small></h1>
            </div>

            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/dashboard" class="sidebar-link"><i class="fas fa-home"></i><span>Dashboard</span></a></li>
                    <li><a href="/manual" class="sidebar-link"><i class="fas fa-file-alt"></i><span>Manual</span></a></li>
                    <li><a href="/chat" class="sidebar-link"><i class="fa-solid fa-comment"></i><span>Chat</span></a></li>
                    <li><a href="/rag" class="sidebar-link"><i class="fa-solid fa-comment"></i><span>RAG Chat</span></a></li>
                    <li><a href="/playground" class="sidebar-link"><i class="fa-solid fa-flask-vial"></i><span>Playground</span></a></li>
                    <li><a href="/history" class="sidebar-link"><i class="fa-solid fa-clock-rotate-left"></i><span>History</span></a></li>
                    <li><a href="/settings" class="sidebar-link active"><i class="fas fa-cog"></i><span>Settings</span></a></li>
                    <li><a href="/logout" class="sidebar-link"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></a></li>
                </ul>
                <a href="https://github.com/clusterzx/paperless-ai" class="github-button" style="position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);">
                    <span class="star-button">
                        <svg class="star-icon" height="16" width="16" viewBox="0 0 16 16">
                            <path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"></path>
                        </svg>
                        Star
                    </span>
                    <span id="starCount" class="star-count">1.2k</span>
                </a>
                <p style="position: absolute; bottom: 50px; left: 50%; transform: translateX(-50%); font-size: 10px; color: #555; text-align: center;">
                    Please support us on GitHub
                </p>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="content-wrapper">
                <!-- Header with API Key -->
                <div class="content-header flex justify-between items-center px-6 py-4 bg-white dark:bg-gray-800 shadow-sm">
                    <h2 class="content-title text-2xl font-semibold text-gray-800 dark:text-white">Configuration</h2>
                    <div class="relative flex items-center space-x-4">
                        <span class="text-sm text-gray-600 dark:text-gray-300">API-KEY:</span>
                        <div id="apiKeyContainer"
                             class="relative w-48 px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-100 rounded cursor-pointer select-none filter blur-sm hover:blur-none transition-all duration-200 truncate"
                             data-api-key="<%= vm.settings.API_KEY %>"
                             data-testid="settings-api-key"
                             title="Click to copy">
                            <%= vm.settings.API_KEY %>
                        </div>
                        <button id="regenerateBtn"
                                data-testid="settings-regenerate-btn"
                                class="px-3 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 transition-colors flex items-center space-x-2">
                            <i class="fas fa-sync-alt" id="regenerateIcon"></i>
                            <span>Regenerate</span>
                        </button>
                        <div id="copyNotification"
                             class="absolute right-0 top-12 w-64 bg-green-50 dark:bg-green-900 text-green-800 dark:text-green-100 border border-green-200 dark:border-green-700 rounded-lg p-3 hidden z-50">
                            <div class="flex items-center">
                                <i class="fas fa-check-circle mr-2"></i>
                                <span>API key copied to clipboard!</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Restart Banner Island (fixed at top) -->
                <div data-island="restart-banner-island" data-testid="restart-banner-island" data-props='{"visible": false}'></div>

                <!-- Settings Islands Container -->
                <div class="settings-container">
                    <!-- Sidebar Navigation Island -->
                    <div
                        data-island="settings-sidebar-island"
                        data-testid="settings-sidebar-island"
                        data-props='<%- JSON.stringify({
                            activeCategory: "overview",
                            aiProvider: vm.settings.AI_PROVIDER || "ollama"
                        }) %>'
                    ></div>

                    <!-- Main Settings Content -->
                    <div class="space-y-6">
                        <!-- Overview Dashboard Island -->
                        <div
                            class="settings-section"
                            data-settings-category="overview"
                            data-testid="settings-section-overview"
                        >
                            <div
                                data-island="overview-dashboard-island"
                                data-testid="overview-dashboard-island"
                                data-props='{}'
                            ></div>
                        </div>

                        <!-- Connection Settings Island -->
                        <div
                            class="settings-section"
                            data-settings-category="connection"
                            data-testid="settings-section-connection"
                        >
                            <div
                                data-island="connection-settings-island"
                                data-testid="connection-settings-island"
                                data-props='<%- JSON.stringify({
                                    paperlessApiUrl: vm.settings.PAPERLESS_API_URL || "",
                                    paperlessUsername: vm.settings.PAPERLESS_USERNAME || ""
                                }) %>'
                            ></div>
                        </div>

                        <!-- AI Provider Island -->
                        <div
                            class="settings-section"
                            data-settings-category="ai-provider"
                            data-testid="settings-section-ai-provider"
                        >
                            <div
                                data-island="ai-provider-island"
                                data-testid="ai-provider-island"
                                data-props='<%- JSON.stringify({
                                    provider: vm.settings.AI_PROVIDER || "ollama",
                                    ollamaUrl: vm.settings.OLLAMA_API_URL || "",
                                    ollamaModel: vm.settings.OLLAMA_MODEL || ""
                                }) %>'
                            ></div>
                        </div>

                        <!-- Expert Models Island -->
                        <div
                            class="settings-section"
                            data-settings-category="expert-models"
                            data-testid="settings-section-expert-models"
                        >
                            <div
                                data-island="expert-models-island"
                                data-testid="expert-models-island"
                                data-props='{}'
                            ></div>
                        </div>

                        <!-- Developer Settings Island -->
                        <div
                            class="settings-section"
                            data-settings-category="developer"
                            data-testid="settings-section-developer"
                        >
                            <div
                                data-island="developer-settings-island"
                                data-testid="developer-settings-island"
                                data-props='<%- JSON.stringify(vm.developer || {}) %>'
                            ></div>
                        </div>

                        <!-- Presets Manager Island -->
                        <div
                            class="settings-section"
                            data-settings-category="advanced"
                            data-testid="settings-section-advanced"
                        >
                            <div
                                data-island="presets-manager-island"
                                data-testid="presets-manager-island"
                                data-props='{}'
                            ></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/shared-utilities.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sections = Array.from(document.querySelectorAll('[data-settings-category]'));
            if (!sections.length) return;

            const storageKey = 'settings:lastCategory';
            let provider = '<%= vm.settings.AI_PROVIDER || "ollama" %>';
            let activeCategory = (function getInitialCategory() {
                const hash = window.location.hash.slice(1);
                if (hash) return hash;
                try {
                    return localStorage.getItem(storageKey) || 'overview';
                } catch (err) {
                    return 'overview';
                }
            })();

            function expertAvailable() {
                return provider === 'ollama';
            }

            function normalizeCategory(category) {
                if (!category) return 'overview';
                const exists = sections.some(function (section) {
                    return section.getAttribute('data-settings-category') === category;
                });
                if (!exists) return 'overview';
                if (category === 'expert-models' && !expertAvailable()) {
                    return 'ai-provider';
                }
                return category;
            }

            function applyCategory() {
                activeCategory = normalizeCategory(activeCategory);

                sections.forEach(function (section) {
                    const category = section.getAttribute('data-settings-category');
                    const isActive = category === activeCategory;
                    const expertBlocked = category === 'expert-models' && !expertAvailable();
                    section.classList.toggle('hidden', expertBlocked || !isActive);
                });

                try {
                    localStorage.setItem(storageKey, activeCategory);
                } catch (err) {
                    // Ignore storage failures in restricted environments.
                }
            }

            function syncCategoryEvent() {
                document.dispatchEvent(new CustomEvent('settings:category-changed', {
                    detail: { category: activeCategory }
                }));
            }

            applyCategory();
            syncCategoryEvent();

            document.addEventListener('settings:category-changed', function (e) {
                const nextCategory = e?.detail?.category;
                if (nextCategory) {
                    activeCategory = nextCategory;
                    applyCategory();
                }
            });

            document.addEventListener('settings:changed', function (e) {
                const nextProvider = e?.detail?.settings?.AI_PROVIDER;
                if (!nextProvider) return;

                provider = String(nextProvider);
                const normalized = normalizeCategory(activeCategory);
                const categoryChanged = normalized !== activeCategory;
                activeCategory = normalized;
                applyCategory();
                if (categoryChanged) {
                    syncCategoryEvent();
                }
            });

            window.addEventListener('hashchange', function () {
                const hash = window.location.hash.slice(1);
                if (hash) {
                    activeCategory = hash;
                    applyCategory();
                }
            });
        });
    </script>

    <!-- Island Runtime -->
    <%- include('partials/island-loader', { 
        bundles: [
            '/js/dist/overview-dashboard.island.js',
            '/js/dist/settings-sidebar.island.js',
            '/js/dist/restart-banner.island.js',
            '/js/dist/connection-settings.island.js',
            '/js/dist/ai-provider.island.js',
            '/js/dist/expert-models.island.js',
            '/js/dist/developer-settings.island.js',
            '/js/dist/presets-manager.island.js'
        ]
    }) %>
</body>
</html>
