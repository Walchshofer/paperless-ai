<!DOCTYPE html>
<html lang="en" data-theme="light" data-page="history-document">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document Preview - Paperless-AI</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="bg-gray-50 text-gray-900" data-page="<%= vm.page || 'history-document' %>">
    <main class="max-w-5xl mx-auto p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-sm text-gray-500">History Document Preview</p>
                <h1 class="text-2xl font-bold"><%= vm.title %></h1>
            </div>
            <div class="flex flex-wrap gap-2">
                <button data-testid="history-feedback-button" onclick="feedbackForm.show({ documentId: '<%= vm.documentId %>' })" class="px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-100 text-gray-700" title="Provide feedback on extraction accuracy">
                    <i class="fas fa-thumbs-up mr-1"></i> Feedback
                </button>
                <a href="/history" data-testid="history-back-link" class="px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-100">
                    <i class="fas fa-arrow-left mr-1"></i> Back to History
                </a>
                <% if (vm.paperlessUrl) { %>
                    <a href="<%= vm.paperlessUrl %>/documents/<%= vm.documentId %>/" target="_blank" rel="noopener" data-testid="history-open-paperless-link" class="px-3 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        <i class="fas fa-external-link-alt mr-1"></i> Open in Paperless
                    </a>
                <% } else { %>
                    <button disabled
                            class="px-3 py-2 text-sm bg-gray-300 text-gray-500 rounded-lg cursor-not-allowed"
                            title="Paperless URL not configured. Please complete setup."
                            data-testid="history-open-paperless-disabled">
                        <i class="fas fa-external-link-alt mr-1"></i> Open in Paperless
                    </button>
                <% } %>
            </div>
        </div>

        <div class="mt-4 grid gap-3 sm:grid-cols-2 text-sm text-gray-600">
            <div><span class="font-medium text-gray-800">Document ID:</span> <%= vm.documentId %></div>
            <div><span class="font-medium text-gray-800">Correspondent:</span> <%= vm.correspondent %></div>
            <div><span class="font-medium text-gray-800">Created:</span> <%= vm.createdAt || 'Unknown' %></div>
            <div><span class="font-medium text-gray-800">Tags:</span> <%= vm.tags.length ? vm.tags.join(', ') : 'None' %></div>
        </div>
        <div id="historyFallbackBanner" class="mt-4 hidden rounded border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Visual analysis is unavailable. Showing text-only results. Visual evidence required for full validation.
        </div>

        <div class="mt-6 bg-white border border-gray-200 rounded-lg p-4">
            <div class="grid gap-4 md:grid-cols-5 min-h-96">
                <div class="md:col-span-3" data-island="overlay-viewer-island" data-testid="overlay-viewer-island" data-props="<%= JSON.stringify({ documentId: vm.documentId, page: 1, originalUrl: vm.original_url || null, images: vm.images || [], overlaysByImage: vm.overlaysByImage || {}, pageCount: vm.page_count || 1, overlayMode: 'document', showLegend: true, allowSelection: true }) %>"></div>
                <div data-island="visual-overlays-island" data-testid="visual-overlays-island" data-props="<%= JSON.stringify({ documentId: vm.documentId, images: vm.images || [], overlaysByImage: vm.overlaysByImage || {} }) %>"></div>
                <div class="md:col-span-2" data-island="history-tabs-island" data-testid="history-tabs" data-props="<%= JSON.stringify({ documentId: vm.documentId, content: vm.content, metadata: vm.metadata }) %>"></div>
            </div>
        </div>
    </main>

    <!-- Feedback Modal -->
    <%- include('partials/feedback-modal') %>

    <!-- Feedback Form Component -->
    <script src="/js/components/FeedbackForm.js"></script>
    <script type="module">
      import { mountIslands } from '/js/dist/island-runtime.js';
      mountIslands(document);
      window.__islandRuntimeMounted = true;

      const banner = document.getElementById('historyFallbackBanner');
      if (banner) {
        try {
          const [visualResp, ragResp] = await Promise.allSettled([
            fetch('/api/visual-rag/health').then(res => res.json()),
            fetch('/api/rag/status').then(res => res.json())
          ]);

          const visualOk = visualResp.status === 'fulfilled' &&
            visualResp.value?.visualSearchClient === true;
          const ragStatus = ragResp.status === 'fulfilled' ? ragResp.value : null;
          const textOk = Boolean(
            ragStatus &&
            ragStatus.server_up &&
            (ragStatus.index_ready || ragStatus.data_loaded) &&
            !ragStatus.disabled
          );

          const showFallback = !visualOk && textOk;
          banner.classList.toggle('hidden', !showFallback);
        } catch (error) {
          banner.classList.add('hidden');
        }
      }

    </script>
</body>
</html>
