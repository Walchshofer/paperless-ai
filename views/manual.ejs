    <script src="js/components/OverlayLegend.js"></script>
    <script type="module" src="/js/dist/island-runtime.js"></script>
    <script>
        // Overlay Viewer Integration
        let overlayViewer = null;
        let overlayLegend = null;
        let overlaysLoaded = false;
        let currentViewMode = 'text'; // 'text' or 'visual'

        // Page navigation state
        let currentPage = 1;
        let totalPages = 1;
        let cachedPageCount = null;

        // View toggle buttons
        document.getElementById('viewTextBtn').addEventListener('click', () => switchView('text'));
        document.getElementById('viewVisualBtn').addEventListener('click', () => switchView('visual'));

        function switchView(mode) {
            currentViewMode = mode;
            const textSection = document.getElementById('textPreviewSection');
            const visualSection = document.getElementById('visualPreviewSection');
            const textBtn = document.getElementById('viewTextBtn');
            const visualBtn = document.getElementById('viewVisualBtn');

            if (mode === 'text') {
                textSection.classList.remove('hidden');
                visualSection.classList.add('hidden');
                textBtn.classList.add('bg-accent-primary', 'text-white');
                textBtn.classList.remove('bg-bg-secondary', 'text-text-primary', 'border', 'border-border-color');
                visualBtn.classList.remove('bg-accent-primary', 'text-white');
                visualBtn.classList.add('bg-bg-secondary', 'text-text-primary', 'border', 'border-border-color');
            } else {
                textSection.classList.add('hidden');
                visualSection.classList.remove('hidden');
                visualBtn.classList.add('bg-accent-primary', 'text-white');
                visualBtn.classList.remove('bg-bg-secondary', 'text-text-primary', 'border', 'border-border-color');
                textBtn.classList.remove('bg-accent-primary', 'text-white');
                textBtn.classList.add('bg-bg-secondary', 'text-text-primary', 'border', 'border-border-color');

                // Load overlays if not already loaded and document is selected
                if (!overlaysLoaded && currentDocument) {
                    loadVisualOverlays(currentDocument);
                }
            }
        }

        async function loadVisualOverlays(docId) {
            if (!docId) return;

            const container = document.getElementById('overlayContainer');
            const loading = document.getElementById('overlayLoading');
            const legendContainer = document.getElementById('overlayLegendContainer');
            const statsEl = document.getElementById('overlayStats');
            const pageNav = document.getElementById('pageNavigation');

            loading.classList.remove('hidden');
            container.innerHTML = '';
            container.appendChild(loading);

            try {
                // Get page count first
                if (cachedPageCount === null) {
                    const infoRes = await fetch(`/api/document/${docId}/page-count`);
                    if (infoRes.ok) {
                        const info = await infoRes.json();
                        totalPages = info.pageCount || 1;
                        cachedPageCount = totalPages;
                    } else {
                        totalPages = 1;
                        cachedPageCount = 1;
                    }
                } else {
                    totalPages = cachedPageCount;
                }

                currentPage = 1;

                // Load the first page at high resolution
                await loadPageImage(docId, currentPage);

                // Update page navigation
                updatePageNavigation();

                overlaysLoaded = true;
            } catch (error) {
                console.error('Failed to load visual overlays:', error);
                loading.classList.add('hidden');
                container.innerHTML = `<div class="text-center text-red-500 py-8">Failed to load visual preview: ${error.message}</div>`;
            }
        }

        async function loadPageImage(docId, page) {
            const container = document.getElementById('overlayContainer');
            const loading = document.getElementById('overlayLoading');
            const legendContainer = document.getElementById('overlayLegendContainer');
            const statsEl = document.getElementById('overlayStats');

            // Show loading
            loading.classList.remove('hidden');

            try {
                // Render high-res image for this page
                const renderRes = await fetch(`/api/document/${docId}/render?page=${page}&dpi=300`);
                if (!renderRes.ok) throw new Error('Failed to render page');

                const renderData = await renderRes.json();

                // Create image from base64
                const img = new Image();
                img.src = `data:image/png;base64,${renderData.image}`;
                img.style.maxWidth = '100%';
                img.style.height = 'auto';

                await new Promise((resolve, reject) => {
                    img.onload = resolve;
                    img.onerror = () => reject(new Error('Failed to load rendered image'));
                });

                // Update total pages if provided
                if (renderData.totalPages) {
                    totalPages = renderData.totalPages;
                }

                // Fetch overlays for this page
                const overlayRes = await fetch(`/api/visual-rag/overlays/${docId}?page=${page}`);
                const data = await overlayRes.json();

                loading.classList.add('hidden');

                // Clear container and add image
                container.innerHTML = '';
                container.appendChild(img);

                // Initialize overlay viewer
                if (overlayViewer) {
                    overlayViewer.destroy();
                }

                overlayViewer = new OverlayViewer(container, {
                    onOverlayClick: (overlay) => {
                        console.log('Clicked overlay:', overlay);
                    },
                    onOverlayHover: (overlay) => {
                        if (overlay && overlayLegend) {
                            overlayLegend.highlightField(overlay.label.toLowerCase().replace(/\s+/g, '_'));
                        } else if (overlayLegend) {
                            overlayLegend.clearHighlights();
                        }
                    }
                });

                overlayViewer.setImage(img);

                if (data.overlays && data.overlays.length > 0) {
                    const domain = data.overlays[0]?.domain || 'GENERAL';
                    overlayViewer.setOverlays(data.overlays, domain);

                    // Initialize legend
                    if (overlayLegend) {
                        overlayLegend.destroy();
                    }
                    overlayLegend = new OverlayLegend(legendContainer, {
                        domain: domain,
                        onFilterChange: ({ mandatoryOnly }) => {
                            overlayViewer.toggleMandatoryOnly(mandatoryOnly);
                        }
                    });

                    // Show stats
                    const stats = overlayViewer.getStats();
                    document.getElementById('overlayCount').textContent = stats.total;
                    const mandatoryEl = document.getElementById('mandatoryCount');
                    if (stats.mandatory > 0) {
                        mandatoryEl.textContent = `(${stats.mandatory} mandatory)`;
                    } else {
                        mandatoryEl.textContent = '';
                    }
                    statsEl.classList.remove('hidden');
                } else {
                    legendContainer.innerHTML = '';
                    statsEl.classList.add('hidden');
                }
            } catch (error) {
                console.error('Failed to load page:', error);
                loading.classList.add('hidden');
                container.innerHTML = `<div class="text-center text-red-500 py-8">Failed to load page: ${error.message}</div>`;
            }
        }

        function updatePageNavigation() {
            const pageNav = document.getElementById('pageNavigation');
            const pageIndicator = document.getElementById('pageIndicator');
            const prevBtn = document.getElementById('prevPage');
            const nextBtn = document.getElementById('nextPage');

            if (totalPages > 1) {
                pageNav.classList.remove('hidden');
                pageIndicator.textContent = `Page ${currentPage} of ${totalPages}`;
                prevBtn.disabled = currentPage <= 1;
                nextBtn.disabled = currentPage >= totalPages;
            } else {
                pageNav.classList.add('hidden');
            }
        }

        // Page navigation handlers
        document.getElementById('prevPage').addEventListener('click', async () => {
            if (currentPage > 1 && currentDocument) {
                currentPage--;
                await loadPageImage(currentDocument, currentPage);
                updatePageNavigation();
            }
        });

        document.getElementById('nextPage').addEventListener('click', async () => {
            if (currentPage < totalPages && currentDocument) {
                currentPage++;
                await loadPageImage(currentDocument, currentPage);
                updatePageNavigation();
            }
        });

        // Reset overlays when document changes
        const originalHandleDocumentSelection = handleDocumentSelection;
        handleDocumentSelection = async function(documentId) {
            overlaysLoaded = false;
            cachedPageCount = null; // Reset page count cache
            currentPage = 1;
            totalPages = 1;

            if (overlayViewer) {
                overlayViewer.destroy();
                overlayViewer = null;
            }
            if (overlayLegend) {
                overlayLegend.destroy();
                overlayLegend = null;
            }
            document.getElementById('overlayContainer').innerHTML = `
                <div id="overlayLoading" class="flex items-center justify-center h-[400px] text-text-secondary">
                    <i class="fas fa-spinner fa-spin mr-2"></i> Rendering high-resolution preview...
                </div>
            `;
            document.getElementById('overlayLegendContainer').innerHTML = '';
            document.getElementById('overlayStats').classList.add('hidden');
            document.getElementById('pageNavigation').classList.add('hidden');

            await originalHandleDocumentSelection(documentId);

            // Auto-load visual if in visual mode
            if (currentViewMode === 'visual' && documentId) {
                loadVisualOverlays(documentId);
            }
        };

        // Visual Analysis button handler
        document.getElementById('analyzeVisualBtn').addEventListener('click', async () => {
            if (!currentDocument) return;

            const btn = document.getElementById('analyzeVisualBtn');
            const status = document.getElementById('aiStatus');
            const statusText = status.querySelector('.text-sm');

            btn.disabled = true;
            status.classList.remove('hidden');
            statusText.textContent = 'Running Visual Analysis (Expert Pipeline)...';

            try {
                const response = await fetch('/manual/analyze-visual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ docId: currentDocument })
                });

                const data = await response.json();

                if (!data.success) {
                    throw new Error(data.error || 'Visual analysis failed');
                }

                // Update suggested tags
                const suggestedTagsContainer = document.getElementById('suggestedTags');
                if (data.result.tags && Array.isArray(data.result.tags)) {
                    const tagHtml = data.result.tags.map(tag =>
                        `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-accent-primary/10 text-accent-primary cursor-pointer hover:bg-accent-primary hover:text-white transition-colors" onclick="addSuggestedTag(this, '${tag}')">${tag}</span>`
                    ).join('');
                    suggestedTagsContainer.innerHTML = tagHtml;
                }

                // Show correspondent suggestion
                if (data.result.correspondent) {
                    const correspondentDisplay = document.getElementById('correspondentDisplay');
                    if (correspondentDisplay) {
                        correspondentDisplay.textContent = `Suggested: ${data.result.correspondent}`;
                    }
                }

                // Reload overlays if in visual mode
                if (currentViewMode === 'visual') {
                    overlaysLoaded = false;
                    cachedPageCount = null;
                    await loadVisualOverlays(currentDocument);
                }

                statusText.textContent = `Visual analysis complete! Domain: ${data.result.domain || 'general'}, Overlays: ${data.overlayCount}`;
                setTimeout(() => {
                    status.classList.add('hidden');
                    btn.disabled = false;
                }, 3000);

            } catch (error) {
                console.error('Visual analysis error:', error);
                statusText.textContent = `Error: ${error.message}`;
                setTimeout(() => {
                    status.classList.add('hidden');
                    btn.disabled = false;
                }, 5000);
            }
        });
    </script>

