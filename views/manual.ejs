<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="light" data-page="manual">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paperless-AI Dashboard</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/self-guiding.css">
    <link rel="stylesheet" href="css/overlay-viewer.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
</head>
<body class="h-full" data-page="<%= vm.page || 'manual' %>">
    <% /* Ensure `vm` exists to avoid ReferenceError when rendering anchors in environments without view model */ %>
    <% var vm = typeof vm !== 'undefined' ? vm : {}; %>
    <% var manualVm = vm.manual || {}; %>
    <% var manualProps = {
         documentId: manualVm.documentId || null,
         metadata: manualVm.metadata || {},
         content: manualVm.content || '',
         fields: manualVm.fields || [],
         originalUrl: manualVm.originalUrl || null
       }; %>
    <% var viewModeProps = {
         documentId: manualProps.documentId,
         mode: 'text',
         visualEnabled: true
       }; %>
    <% var tagsProps = {
         documentId: manualProps.documentId,
         currentTags: manualVm.tags || [],
         suggestedTags: [],
         availableTags: []
       }; %>
    <% var aiAnalysisProps = {
         documentId: manualProps.documentId,
         content: manualProps.content || '',
         gpuState: 'idle'
       }; %>
    <% var manualWorkspaceProps = {
         documentId: manualProps.documentId,
         content: manualProps.content || '',
         title: (manualProps.metadata && manualProps.metadata.title) || null,
         correspondent: (manualProps.metadata && manualProps.metadata.correspondent) || null,
         tags: manualVm.tags || [],
         originalUrl: manualProps.originalUrl || null,
         pageCount: manualVm.pageCount || null
       }; %>
    <button id="themeToggle" data-testid="theme-toggle" class="theme-toggle">
        <i class="fas fa-moon dark:fas fa-sun"></i>
    </button>

    <div class="layout-container">
        <button id="mobileMenuButton" data-testid="mobile-menu-button" class="mobile-menu-button">
            <i class="fas fa-bars"></i>
        </button>
        <!-- Sidebar -->
        <div id="sidebarOverlay" class="sidebar-overlay"></div>
        <aside class="sidebar">
            <div class="sidebar-header">
                <img src="/favicon.ico" class="no-invert" alt="Paperless AI Logo" style="height: 60px;">
                <h1 class="brand-title">Paperless-AI<small style="display: block;"><%= vm.version || '' %></small></h1>
            </div>

            <nav class="sidebar-nav">
                <ul>
                    <li>
                        <a href="/dashboard" class="sidebar-link">
                            <i class="fas fa-home"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="/manual" class="sidebar-link active">
                            <i class="fas fa-file-alt"></i>
                            <span>Manual</span>
                        </a>
                    </li>
                    <li>
                        <a href="/chat" class="sidebar-link">
                            <i class="fa-solid fa-comment"></i>
                            <span>Chat</span>
                        </a>
                    </li>
                    <li>
                        <a href="/rag" class="sidebar-link">
                            <i class="fa-solid fa-comment"></i>
                            <span>RAG Chat</span>
                        </a>
                    </li>                    
                    <li>
                        <a href="/playground" class="sidebar-link">
                            <i class="fa-solid fa-flask-vial"></i>
                            <span>Playground</span>
                        </a>
                    </li>
                    <li>
                        <a href="/history" class="sidebar-link">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            <span>History</span>
                        </a>
                    </li>
                    <li>
                        <a href="/settings" class="sidebar-link">
                            <i class="fas fa-cog"></i>
                            <span>Settings</span>
                        </a>
                    </li>
                    <li>
                        <a href="/logout" class="sidebar-link">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span>Logout</span>
                        </a>
                    </li>
                </ul>
                <a href="https://github.com/clusterzx/paperless-ai" 
                class="github-button" 
                style="position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);">
                <span class="star-button">
                    <svg class="star-icon" height="16" width="16" viewBox="0 0 16 16">
                        <path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"></path>
                    </svg>
                    Star
                </span>
                <span id="starCount" class="star-count">1.2k</span>
            </a>
            <p style="position: absolute; bottom: 50px; left: 50%; transform: translateX(-50%); font-size: 10px; color: #555; text-align: center;">
                Please support us on GitHub
            </p>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="content-wrapper sg-shell">
                <div
                    data-island="manual-workspace-island"
                    data-testid="manual-workspace-island"
                    data-props="<%= JSON.stringify(manualWorkspaceProps) %>"
                ></div>

                <!-- Island anchors (auditable via data-testid) -->
                <div data-island="visual-annotation-island" data-testid="visual-annotation-island" data-props="<%= JSON.stringify({ documentId: manualProps.documentId }) %>"></div>
                <div data-island="feedback-controls-island" data-testid="feedback-controls-island" data-props="<%= JSON.stringify({ documentId: manualProps.documentId }) %>"></div>
                <div data-island="export-panel-island" data-testid="export-panel-island" data-props="<%= JSON.stringify({ documentId: manualProps.documentId }) %>"></div>
        
                <!-- Document Selection -->
                <div class="material-card mb-6">
                    <h2 class="card-title">Select Document</h2>
                    <select id="documentSelect" data-testid="manual-document-select" class="w-full rounded-md border-border-color bg-bg-primary text-text-primary p-2 focus:border-accent-primary focus:ring-accent-primary">
                        <option value="">Choose a document...</option>
                    </select>
                </div>

                <div class="material-card mb-6" data-testid="manual-editor-card">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="card-title mb-0">Manual Editor</h2>
                        <span class="text-xs text-text-muted">
                            Edits sync to Paperless
                        </span>
                    </div>
                    <div
                        data-island="manual-editor-island"
                        data-testid="manual-editor-island"
                        data-props="<%= JSON.stringify(manualProps) %>"
                    ></div>
                </div>

                <!-- Main Grid -->
                <div class="card-grid">
                    <!-- Document Preview Card -->
                    <div class="material-card col-span-2">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="card-title mb-0">Document Preview</h2>
                            <div
                                data-island="view-mode-toggle-island"
                                data-testid="view-mode-toggle-island"
                                data-props="<%= JSON.stringify(viewModeProps) %>"
                            ></div>
                        </div>
                        <!-- Correspondent Info -->
                        <div id="correspondentInfo" class="stat-box mb-4 hidden">
                            <h3 class="text-sm font-medium">Correspondent:</h3>
                            <p id="correspondentName"></p>
                        </div>
                        <div id="titleInfo" class="stat-box mb-4 hidden">
                            <h3 class="text-sm font-medium">Title:</h3>
                            <p id="titleName"></p>
                        </div>

                        <!-- Text Preview (default) -->
                        <div id="textPreviewSection" class="stat-box">
                            <div class="min-h-[600px] h-[600px] bg-bg-primary rounded border border-border-color overflow-hidden">
                                <div
                                    data-island="document-content-island"
                                    data-testid="document-content-island"
                                    data-props="<%= JSON.stringify({ documentId: manualProps.documentId, content: manualProps.content }) %>"
                                ></div>
                            </div>
                        </div>
                        </div>

                        <!-- Visual Preview with Overlays (hidden by default) -->
                        <div id="visualPreviewSection" class="stat-box hidden">
                            <div class="flex flex-col lg:flex-row gap-4">
                                <div id="overlayContainer" class="flex-1 min-h-[600px] bg-bg-primary rounded border border-border-color p-4 overflow-auto">
                                    <div
                                        data-island="overlay-viewer-island"
                                        data-testid="overlay-viewer-island"
                                        data-props="<%= JSON.stringify({ documentId: manualProps.documentId, page: 1, originalUrl: manualProps.originalUrl, pageCount: manualVm.pageCount || null, overlayMode: 'document', showLegend: true, allowSelection: true, images: manualVm.images || [], overlaysByImage: manualVm.overlaysByImage || {} }) %>"
                                    ></div>

                                    <div
                                        data-island="visual-overlays-island"
                                        data-testid="visual-overlays-island"
                                        data-props="<%= JSON.stringify({ documentId: manualProps.documentId, images: manualVm.images || [], overlaysByImage: manualVm.overlaysByImage || {} }) %>"
                                    ></div>
                                </div>
                            </div>
                        </div>
                    </div>
        
                    <!-- AI and Tags Section -->
                    <div class="col-span-2">
                        <!-- AI Analysis Card -->
                        <div class="material-card mb-6">
                            <h2 class="card-title">AI Analysis</h2>
                            <div
                                data-island="ai-analysis-island"
                                data-testid="ai-analysis-island"
                                data-props="<%= JSON.stringify(aiAnalysisProps) %>"
                            ></div>
                        </div>
        
                        <!-- Tags Card -->
                        <div class="material-card">
                            <h2 class="card-title">Tags</h2>
                            <div
                                data-island="tags-manager-island"
                                data-testid="tags-manager-island"
                                data-props="<%= JSON.stringify(tagsProps) %>"
                            ></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script src="/js/shared-utilities.js"></script>
    <%- include('partials/island-loader', { 
        bundles: [
            '/js/dist/manual-workspace.island.js',
            '/js/dist/manual-editor.island.js',
            '/js/dist/view-mode-toggle.island.js',
            '/js/dist/document-content.island.js',
            '/js/dist/overlay-viewer.island.js',
            '/js/dist/visual-overlays.island.js',
            '/js/dist/tags-manager.island.js',
            '/js/dist/ai-analysis.island.js',
            '/js/dist/visual-annotation.island.js',
            '/js/dist/feedback-controls.island.js',
            '/js/dist/export-panel.island.js'
        ]
    }) %>
</body>
</html>
