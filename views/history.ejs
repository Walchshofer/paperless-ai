<!-- views/history.ejs -->
<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modified Documents - Paperless-AI</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/self-guiding.css">
    <link rel="stylesheet" href="css/overlay-viewer.css">
</head>
<body class="h-full" data-page="<%= vm.page || 'history' %>">
    <% /* Ensure `vm` exists to avoid ReferenceError when rendering anchors in environments without view model */ %>
    <% var vm = typeof vm !== 'undefined' ? vm : {}; %>
    <% var historyProps = vm.history || {}; %>
    <button id="themeToggle" data-testid="theme-toggle" class="theme-toggle">
        <i class="fas fa-moon dark:fas fa-sun"></i>
    </button>

    <div class="layout-container">
        <button id="mobileMenuButton" data-testid="mobile-menu-button" class="mobile-menu-button">
            <i class="fas fa-bars"></i>
        </button>
        <!-- Sidebar -->
        <div id="sidebarOverlay" class="sidebar-overlay"></div>
        <aside class="sidebar">
            <%- include('partials/sidebar-nav', { active: 'history' }) %>
        </aside>

        <main class="main-content modified-documents-page">
            <div class="content-wrapper">
                <div class="content-header flex justify-between items-center mb-6">
                    <h1 class="content-title sg-display">Modified Documents</h1>
                </div>

                <div
                    data-island="history-manager-island"
                    data-testid="history-manager-island"
                    data-props="<%= JSON.stringify(historyProps) %>"
                ></div>
            </div>
        </main>
    </div>
    <script src="/js/shared-utilities.js"></script>

    <!-- Feedback Modal -->
    <%- include('partials/feedback-modal') %>

    <script src="js/components/FeedbackForm.js"></script>

    <%- include('partials/island-loader') %>
</body>
</html>
