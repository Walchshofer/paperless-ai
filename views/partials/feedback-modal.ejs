<!-- Feedback Modal Partial -->
<!-- Include this at the bottom of pages where feedback is needed -->

<div id="feedback-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="feedback-title">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-black/50 transition-opacity" onclick="feedbackForm.hide()"></div>

    <!-- Modal Panel -->
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="relative bg-white rounded-xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
                <h3 id="feedback-title" class="text-lg font-semibold text-gray-900">
                    <i class="fas fa-comment-dots text-blue-500 mr-2"></i>
                    Extraction Feedback
                </h3>
                <button onclick="feedbackForm.hide()" class="p-1 text-gray-400 hover:text-gray-600 rounded-lg hover:bg-gray-100">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="px-6 py-4 overflow-y-auto max-h-[60vh]">
                <!-- Rating Section -->
                <div class="mb-5">
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        How accurate was the extraction?
                    </label>
                    <div id="feedback-stars" class="flex gap-1">
                        <button type="button" data-rating="1" class="feedback-star p-1 text-2xl text-gray-300 hover:text-yellow-400 transition-colors">
                            <i class="fas fa-star"></i>
                        </button>
                        <button type="button" data-rating="2" class="feedback-star p-1 text-2xl text-gray-300 hover:text-yellow-400 transition-colors">
                            <i class="fas fa-star"></i>
                        </button>
                        <button type="button" data-rating="3" class="feedback-star p-1 text-2xl text-gray-300 hover:text-yellow-400 transition-colors">
                            <i class="fas fa-star"></i>
                        </button>
                        <button type="button" data-rating="4" class="feedback-star p-1 text-2xl text-gray-300 hover:text-yellow-400 transition-colors">
                            <i class="fas fa-star"></i>
                        </button>
                        <button type="button" data-rating="5" class="feedback-star p-1 text-2xl text-gray-300 hover:text-yellow-400 transition-colors">
                            <i class="fas fa-star"></i>
                        </button>
                    </div>
                    <p id="feedback-rating-label" class="mt-1 text-sm text-gray-500">Click to rate</p>
                </div>

                <!-- Correction Fields -->
                <div class="mb-5">
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Which fields had errors? <span class="text-gray-400 font-normal">(optional)</span>
                    </label>
                    <div id="feedback-corrections" class="flex flex-wrap gap-2">
                        <button type="button" data-field="date" class="correction-chip px-3 py-1 text-sm border border-gray-300 rounded-full hover:border-red-400 hover:bg-red-50 transition-colors">
                            Date
                        </button>
                        <button type="button" data-field="amount" class="correction-chip px-3 py-1 text-sm border border-gray-300 rounded-full hover:border-red-400 hover:bg-red-50 transition-colors">
                            Amount
                        </button>
                        <button type="button" data-field="vendor" class="correction-chip px-3 py-1 text-sm border border-gray-300 rounded-full hover:border-red-400 hover:bg-red-50 transition-colors">
                            Vendor
                        </button>
                        <button type="button" data-field="category" class="correction-chip px-3 py-1 text-sm border border-gray-300 rounded-full hover:border-red-400 hover:bg-red-50 transition-colors">
                            Category
                        </button>
                        <button type="button" data-field="description" class="correction-chip px-3 py-1 text-sm border border-gray-300 rounded-full hover:border-red-400 hover:bg-red-50 transition-colors">
                            Description
                        </button>
                        <button type="button" data-field="other" class="correction-chip px-3 py-1 text-sm border border-gray-300 rounded-full hover:border-red-400 hover:bg-red-50 transition-colors">
                            Other
                        </button>
                    </div>
                </div>

                <!-- Comments -->
                <div class="mb-4">
                    <label for="feedback-comments" class="block text-sm font-medium text-gray-700 mb-2">
                        Additional comments <span class="text-gray-400 font-normal">(optional)</span>
                    </label>
                    <textarea
                        id="feedback-comments"
                        rows="3"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none"
                        placeholder="What was wrong or could be improved?"
                    ></textarea>
                </div>

                <!-- Hidden fields -->
                <input type="hidden" id="feedback-document-id">
                <input type="hidden" id="feedback-pipeline-id">
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-gray-200 bg-gray-50">
                <button
                    type="button"
                    onclick="feedbackForm.hide()"
                    class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50"
                >
                    Cancel
                </button>
                <button
                    type="button"
                    id="feedback-submit-btn"
                    onclick="feedbackForm.submit()"
                    class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed"
                    disabled
                >
                    <i class="fas fa-paper-plane mr-1"></i>
                    Submit Feedback
                </button>
            </div>

            <!-- Success State (hidden by default) -->
            <div id="feedback-success" class="hidden absolute inset-0 bg-white flex flex-col items-center justify-center p-6">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
                    <i class="fas fa-check text-green-600 text-2xl"></i>
                </div>
                <h4 class="text-lg font-semibold text-gray-900 mb-2">Thank You!</h4>
                <p class="text-sm text-gray-600 text-center mb-4">Your feedback helps improve extraction accuracy.</p>
                <button
                    type="button"
                    onclick="feedbackForm.hide()"
                    class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700"
                >
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .feedback-star.active {
        color: #facc15; /* yellow-400 */
    }
    .correction-chip.active {
        border-color: #f87171; /* red-400 */
        background-color: #fef2f2; /* red-50 */
        color: #dc2626; /* red-600 */
    }
</style>
