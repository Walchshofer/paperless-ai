<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="light" data-page="document-workspace">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unified Document Workspace | Paperless-AI</title>
    <script src="https://cdn.tailwindcss.com/3.4.16"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Space+Grotesk:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/self-guiding.css">
    <link rel="stylesheet" href="/js/dist/island-runtime.css">
    <link rel="stylesheet" href="/css/overlay-viewer.css">
    <style>
        :root {
            --header-height: 64px;
            --sidebar-width: 480px;
            --sidebar-min-width: 320px;
            --sidebar-max-width: 700px;
        }
        .workspace-layout {
            display: grid;
            grid-template-rows: var(--header-height) 1fr;
            height: 100vh;
            overflow: hidden;
        }
        .workspace-body {
            display: grid;
            grid-template-columns: 1fr var(--sidebar-width);
            overflow: hidden;
            position: relative;
        }
        @media (max-width: 1024px) {
            .workspace-body {
                grid-template-columns: 1fr;
            }
            .workspace-sidebar {
                display: none;
            }
            .resize-handle-container {
                display: none !important;
            }
        }
        .accent-copper { color: #b87333; }
        .bg-copper { background-color: #b87333; }
        .border-copper { border-color: #b87333; }
        
        /* Resize handle hover effect */
        .resize-handle:hover,
        .resize-handle:focus-visible {
            background-color: #b87333 !important;
        }
        .resize-handle:focus-visible {
            outline: 2px solid #b87333;
            outline-offset: 2px;
        }
        
        /* Workspace sidebar constraints */
        .workspace-sidebar {
            min-width: var(--sidebar-min-width);
            max-width: var(--sidebar-max-width);
            width: var(--sidebar-width);
        }
    </style>
</head>
<body class="h-full bg-[#fdfaf6] text-[#2c2c2c]" data-page="document-workspace">
    <% var vm = typeof vm !== 'undefined' ? vm : {}; %>
    <% var doc = vm.document || null; %>
    <% var user = vm.user || {}; %>
    <% var ui = vm.ui || {}; %>
    
    <div class="workspace-layout">
        <!-- Header -->
        <header class="h-[64px] border-b border-[#e5e0d8] bg-white flex items-center justify-between px-6 z-20">
            <div class="flex items-center gap-4">
                <a href="/dashboard" class="flex items-center gap-2">
                    <img src="/favicon.ico" class="h-8 w-8 no-invert" alt="Logo">
                    <span class="font-['Fraunces'] font-bold text-xl hidden sm:inline">Paperless-AI</span>
                </a>
                <div class="h-6 w-[1px] bg-[#e5e0d8] mx-2 hidden sm:block"></div>
                <!-- Document Title Island Anchor -->
                <!-- Document Switcher Island (ID-only in header for navigation) -->
                <div 
                    data-island="document-context-bar-island" 
                    data-testid="document-context-bar"
                    data-props="<%= JSON.stringify({ 
                        documentId: doc ? doc.id : null, 
                        title: doc ? doc.title : null,
                        availableDocuments: vm.availableDocuments || [],
                        status: (doc && doc.status) ? doc.status : 'saved'
                    }) %>"
                    class="flex items-center"
                >
                    <span class="text-xs font-bold font-mono text-copper/60 px-2 py-0.5 border border-copper/20 rounded">WORKSPACE</span>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <button id="themeToggle" data-testid="theme-toggle" class="p-2 rounded-full hover:bg-[#f5f0e8] transition-colors">
                    <i class="fas fa-moon dark:fas fa-sun text-[#555]"></i>
                </button>
                <div class="h-6 w-[1px] bg-[#e5e0d8] mx-2"></div>
                <div class="flex items-center gap-2 text-sm text-[#555]">
                    <span class="bg-[#f5f0e8] px-2 py-1 rounded font-mono text-xs"><%= vm.version || '1.0.0' %></span>
                </div>
            </div>
        </header>

        <!-- Document Title Banner (Prominent shared context) -->
        <div class="bg-[#f8f3eb] border-b-2 border-copper/30 px-6 py-3 flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 bg-copper/10 rounded-lg flex items-center justify-center border border-copper/20">
                    <i class="fas fa-file-invoice text-copper text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="font-['Fraunces'] font-bold text-xl text-[#1a1a1a] tracking-tight truncate max-w-[700px]" data-testid="prominent-document-title">
                            <%= (doc && doc.title) ? doc.title : 'Select a document...' %>
                        </h1>
                        <span class="text-xs font-bold font-mono bg-copper/10 text-copper px-2 py-0.5 rounded-full border border-copper/20">#<%= doc ? doc.id : '---' %></span>
                    </div>
                    <div class="flex items-center gap-4 mt-0.5 text-[11px] text-[#6b5a4a] font-medium uppercase tracking-wider">
                        <span class="flex items-center gap-1.5"><i class="fas fa-calendar-alt text-copper/60"></i> Created: <%= doc ? (doc.createdDate || new Date().toLocaleDateString()) : 'N/A' %></span>
                        <span class="flex items-center gap-1.5"><i class="fas fa-sync text-copper/60"></i> Status: <%= doc ? doc.status : 'Idle' %></span>
                    </div>
                </div>
            </div>
            <div class="hidden md:flex items-center gap-2">
                <span class="text-[10px] font-bold text-copper/40 uppercase tracking-widest mr-2">Shared Workspace Context</span>
                <div class="h-8 w-[1px] bg-copper/20 mx-2"></div>
                <div class="flex -space-x-2">
                    <div class="w-8 h-8 rounded-full border-2 border-white bg-copper text-white flex items-center justify-center text-xs font-bold" title="AI Assistant active">AI</div>
                    <div class="w-8 h-8 rounded-full border-2 border-white bg-gray-200 text-[#555] flex items-center justify-center text-xs font-bold" title="<%= user.username %>"><%= user.username.substring(0,1).toUpperCase() %></div>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="workspace-body">
            <!-- Viewer Area (1fr) -->
            <main class="relative bg-[#f5f0e8] overflow-hidden flex flex-col min-h-0">
                <!-- Document Viewer with Overlay Support - Always rendered to listen for document changes -->
                <div
                    data-island="overlay-viewer-island"
                    data-testid="overlay-viewer-island"
                    class="h-full w-full flex flex-col min-h-0"
                    data-props="<%= JSON.stringify({
                        documentId: doc ? doc.id : null,
                        page: 1,
                        pageCount: (doc && doc.pageCount) ? doc.pageCount : 1,
                        originalUrl: (doc && doc.originalUrl) ? doc.originalUrl : null,
                        mode: 'view',
                        overlayMode: 'document',
                        showLegend: false,
                        allowSelection: true,
                        persistedNormalizedUrl: (doc && doc.persistedNormalizedUrl) ? doc.persistedNormalizedUrl : null,
                        normalizationStatus: (doc && doc.normalizationStatus) ? doc.normalizationStatus : null
                    }) %>"
                >
                    <!-- Fallback/Loading Shell -->
                    <div class="flex items-center justify-center h-full">
                        <div class="text-center">
                            <i class="fas fa-circle-notch fa-spin text-3xl text-copper mb-4"></i>
                            <p class="font-['Space_Grotesk'] text-[#555]">Loading document...</p>
                        </div>
                    </div>
                </div>
                <!-- Unified Workspace Island for state management and placeholders -->
                <div
                    data-island="unified-workspace-island"
                    data-testid="unified-workspace-root"
                    class="hidden"
                    data-props="<%= JSON.stringify(vm) %>"
                ></div>
            </main>

            <!-- Resize Handle (between viewer and sidebar) -->
            <div
                data-island="resizable-layout-island"
                data-testid="sidebar-resize-container"
                class="resize-handle-container absolute top-0 bottom-0 right-0 w-0 z-30"
                data-props="<%= JSON.stringify({
                    minWidth: 320,
                    maxWidth: 700,
                    defaultWidth: 480,
                    storageKey: 'paperless-sidebar-width'
                }) %>"
            ></div>

            <!-- Export Panel Modal (global - listens to custom events) -->
            <div
                data-island="export-panel-island"
                data-testid="export-panel-island"
                class="fixed inset-0 z-50 pointer-events-none"
                data-props="<%= JSON.stringify({ documentId: doc ? doc.id : null }) %>"
            ></div>

            <!-- Sidebar (400px) -->
            <aside class="workspace-sidebar border-l border-[#e5e0d8] bg-white flex flex-col overflow-hidden z-10">
                <div 
                    data-island="context-sidebar-island"
                    data-testid="context-sidebar"
                    class="h-full flex flex-col"
                    data-props="<%= JSON.stringify({ 
                        activeTab: ui.activeTab || 'metadata',
                        document: doc,
                        chat: vm.chat || {},
                        visual: vm.visual || { fields: [], overlayCount: 0 },
                        isAdmin: !!user.isAdmin,
                        availableDocuments: vm.availableDocuments || []
                    }) %>"
                >
                    <!-- Fallback Sidebar Tabs -->
                    <div class="flex border-b border-[#e5e0d8] bg-[#fdfaf6]">
                        <button data-testid="tab-metadata" class="flex-1 py-3 text-sm font-['Space_Grotesk'] font-medium border-b-2 border-copper text-copper" title="AI-assisted metadata editing with smart suggestions">
                            <i class="fas fa-wand-magic-sparkles mr-2"></i>
                            <span class="hidden sm:inline">Smart Metadata</span>
                        </button>
                        <button data-testid="tab-content" class="flex-1 py-3 text-sm font-['Space_Grotesk'] font-medium text-[#888]" title="View Tesseract OCR extracted text (read-only)">
                            <i class="fas fa-file-lines mr-2"></i>
                            <span class="hidden sm:inline">OCR Text</span>
                        </button>
                        <button data-testid="tab-chat" class="flex-1 py-3 text-sm font-['Space_Grotesk'] font-medium text-[#888]" title="Chat with AI about documents using RAG or document-specific context">
                            <i class="fas fa-comments mr-2"></i>
                            <span class="hidden sm:inline">Chat</span>
                        </button>
                        <button data-testid="tab-visual" class="flex-1 py-3 text-sm font-['Space_Grotesk'] font-medium text-[#888]" title="Label fields and perform visual search">
                            <i class="fas fa-draw-polygon mr-2"></i>
                            <span class="hidden sm:inline">Visual</span>
                        </button>
                        <% if (user.isAdmin) { %>
                          <button data-testid="tab-debug" class="flex-1 py-3 text-sm font-['Space_Grotesk'] font-medium text-[#888]" title="Developer debugging information">
                              <i class="fas fa-bug mr-2"></i>
                              <span class="hidden sm:inline">Debug</span>
                          </button>
                        <% } %>
                    </div>
                    <div class="p-6">
                        <div class="animate-pulse space-y-4">
                            <div class="h-4 bg-[#f5f0e8] rounded w-3/4"></div>
                            <div class="h-10 bg-[#f5f0e8] rounded"></div>
                            <div class="h-4 bg-[#f5f0e8] rounded w-1/2"></div>
                            <div class="h-32 bg-[#f5f0e8] rounded"></div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>

    <!-- Mobile Menu Button (Floating) -->
    <button id="mobileMenuButton" data-testid="mobile-menu-button" class="lg:hidden fixed bottom-6 right-6 h-14 w-14 bg-copper text-white rounded-full shadow-lg flex items-center justify-center z-50">
        <i class="fas fa-bars text-xl"></i>
    </button>

    <!-- Navigation Sidebar Overlay -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>
    <aside class="sidebar hidden">
        <%- include('partials/sidebar-nav', { active: 'workspace' }) %>
    </aside>

    <script src="/js/shared-utilities.js"></script>
    <%- include('partials/island-loader', { 
        bundles: [
            '/js/dist/unified-workspace.island.js',
            '/js/dist/document-context-bar.island.js',
            '/js/dist/context-sidebar.island.js',
            '/js/dist/overlay-viewer.island.js',
            '/js/dist/document-content.island.js',
            '/js/dist/manual-editor.island.js',
            '/js/dist/chat-workspace.island.js',
            '/js/dist/resizable-layout.island.js'
        ]
    }) %>
</body>
</html>
