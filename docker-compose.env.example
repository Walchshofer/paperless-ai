# Example env file (no secrets)
# Copy to docker-compose.env and add real secrets locally

# Hugging Face token: set locally, do NOT commit
HF_TOKEN=REDACTED
HF_HUB_OFFLINE=

# Indexes
VISUAL_RAG_INDEX_NAME=paperless_visual
INDEX_DIR=./data/visual_indices

# Database (example values)
POSTGRES_USER=paperless
POSTGRES_PASSWORD=changeme
POSTGRES_DB=paperless

# Other runtime defaults
PAPERLESS_MEDIA_ROOT=/usr/src/paperless/media
MEDIA_DIR=${PAPERLESS_MEDIA_ROOT:-/media/paperless}

# Metrics protection (internal-only by default)
# METRICS_INTERNAL_ONLY when true requires METRICS_ALLOWED_CIDRS to be set and will fail-fast on startup if invalid
METRICS_INTERNAL_ONLY=true
METRICS_ALLOWED_CIDRS=127.0.0.1,::1,172.18.0.0/16,10.0.0.0/8
TRUST_PROXY=true

# Video indexing (optional - only needed if video processing is enabled)
# VIDEO_FRAME_INTERVAL: seconds between sampled frames (default: 1)
VIDEO_FRAME_INTERVAL=1
# VIDEO_KEYFRAME_DETECTION: enable keyframe/scene-change detection (yes|no)
VIDEO_KEYFRAME_DETECTION=yes
