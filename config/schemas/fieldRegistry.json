{
  "_version": "1.0.0",
  "_description": "Central registry of all extractable fields. Field IDs are immutable once deployed.",

  "fields": {
    "title": {
      "type": "string",
      "description": "Document title (short, descriptive)",
      "required": true,
      "maxLength": 128
    },
    "correspondent": {
      "type": "string",
      "description": "Document sender/originator (not recipient)",
      "required": true
    },
    "tags": {
      "type": "array",
      "itemType": "string",
      "description": "Classification tags",
      "required": true
    },
    "document_type": {
      "type": "string",
      "description": "Document category (Invoice, Contract, Letter, etc.)",
      "required": true
    },
    "document_date": {
      "type": "string",
      "format": "date",
      "description": "Primary document date (YYYY-MM-DD)",
      "required": true
    },
    "language": {
      "type": "string",
      "description": "Document language (ISO 639-1: en, de, es, etc.)",
      "required": true,
      "enum": ["en", "de", "es", "fr", "it", "nl", "pl", "pt", "ru", "zh", "ja", "ko"]
    },

    "invoice_number": {
      "type": "string",
      "description": "Invoice/receipt number",
      "domain": "financial"
    },
    "invoice_amount": {
      "type": "number",
      "description": "Total invoice amount (no currency symbol)",
      "domain": "financial"
    },
    "invoice_vat": {
      "type": "number",
      "description": "VAT/tax amount",
      "domain": "financial"
    },
    "invoice_net": {
      "type": "number",
      "description": "Net amount before tax",
      "domain": "financial"
    },
    "payment_due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date (YYYY-MM-DD)",
      "domain": "financial"
    },
    "iban": {
      "type": "string",
      "description": "Bank account IBAN",
      "domain": "financial"
    },
    "currency": {
      "type": "string",
      "description": "Currency code (EUR, USD, etc.)",
      "domain": "financial",
      "enum": ["EUR", "USD", "GBP", "CHF", "PLN", "CZK", "SEK", "NOK", "DKK"]
    },

    "bic": {
      "type": "string",
      "description": "Bank Identifier Code (BIC/SWIFT)",
      "domain": "financial"
    },
    "payment_reference": {
      "type": "string",
      "description": "Payment reference / Verwendungszweck",
      "domain": "financial"
    },
    "total_gross": {
      "type": "number",
      "description": "Gross total including VAT",
      "domain": "financial"
    },
    "total_net": {
      "type": "number",
      "description": "Net total before VAT",
      "domain": "financial"
    },
    "uid": {
      "type": "string",
      "description": "Austrian tax identification number",
      "domain": "financial"
    },
    "vat_rate": {
      "type": "number",
      "description": "VAT percentage rate (e.g., 20, 10, 13)",
      "domain": "financial"
    },

    "patient_name": {
      "type": "string",
      "description": "Patient name",
      "domain": "medical"
    },
    "doctor_name": {
      "type": "string",
      "description": "Doctor/physician name",
      "domain": "medical"
    },
    "diagnosis": {
      "type": "string",
      "description": "Medical diagnosis or finding",
      "domain": "medical"
    },
    "medication": {
      "type": "array",
      "itemType": "string",
      "description": "List of medications",
      "domain": "medical"
    },
    "lab_values": {
      "type": "object",
      "description": "Lab test results as key-value pairs",
      "domain": "medical"
    },
    "appointment_date": {
      "type": "string",
      "format": "date",
      "description": "Medical appointment date",
      "domain": "medical"
    },
    "provider_name": {
      "type": "string",
      "description": "Healthcare provider / facility name",
      "domain": "medical"
    },
    "provider_location": {
      "type": "string",
      "description": "Provider location / address",
      "domain": "medical"
    },
    "report_date": {
      "type": "string",
      "format": "date",
      "description": "Medical report date",
      "domain": "medical"
    },
    "insurance": {
      "type": "string",
      "description": "Insurance provider name",
      "domain": "medical",
      "optional": true
    },

    "lab_panel_name": {
      "type": "string",
      "description": "Name of the lab panel (e.g. Standardlabor, Immunstatus, Zytokinprofil)",
      "domain": "medical"
    },
    "lab_report_date": {
      "type": "string",
      "format": "date",
      "description": "Date on the lab report (YYYY-MM-DD)",
      "domain": "medical"
    },
    "crp_mg_l": {
      "type": "number",
      "description": "C-reactive protein (CRP), mg/L; aliases: CRP, C-reaktives Protein",
      "domain": "medical"
    },
    "esr_mm_h": {
      "type": "number",
      "description": "Erythrocyte sedimentation rate (ESR/BSG), mm/h; aliases: BSG, Blutsenkung",
      "domain": "medical"
    },
    "ferritin_ug_l": {
      "type": "number",
      "description": "Ferritin, µg/L",
      "domain": "medical"
    },
    "fibrinogen_g_l": {
      "type": "number",
      "description": "Fibrinogen, g/L",
      "domain": "medical"
    },
    "d_dimer_mg_l_feu": {
      "type": "number",
      "description": "D-Dimer, mg/L FEU",
      "domain": "medical"
    },
    "alt_u_l": {
      "type": "number",
      "description": "Alanine aminotransferase (ALT/GPT), U/L",
      "domain": "medical"
    },
    "ast_u_l": {
      "type": "number",
      "description": "Aspartate aminotransferase (AST/GOT), U/L",
      "domain": "medical"
    },
    "g_gt_u_l": {
      "type": "number",
      "description": "Gamma-glutamyl transferase (GGT), U/L",
      "domain": "medical"
    },
    "ldh_u_l": {
      "type": "number",
      "description": "Lactate dehydrogenase (LDH), U/L",
      "domain": "medical"
    },
    "creatinine_mg_dl": {
      "type": "number",
      "description": "Creatinine, mg/dL",
      "domain": "medical"
    },
    "igg_g_l": {
      "type": "number",
      "description": "IgG total, g/L",
      "domain": "medical"
    },
    "iga_g_l": {
      "type": "number",
      "description": "IgA, g/L",
      "domain": "medical"
    },
    "igm_g_l": {
      "type": "number",
      "description": "IgM, g/L",
      "domain": "medical"
    },
    "igg1_g_l": {
      "type": "number",
      "description": "IgG1 subclass, g/L",
      "domain": "medical"
    },
    "igg2_g_l": {
      "type": "number",
      "description": "IgG2 subclass, g/L",
      "domain": "medical"
    },
    "igg3_g_l": {
      "type": "number",
      "description": "IgG3 subclass, g/L",
      "domain": "medical"
    },
    "igg4_g_l": {
      "type": "number",
      "description": "IgG4 subclass, g/L",
      "domain": "medical"
    },
    "c3c_g_l": {
      "type": "number",
      "description": "Complement C3c, g/L",
      "domain": "medical"
    },
    "c4_g_l": {
      "type": "number",
      "description": "Complement C4, g/L",
      "domain": "medical"
    },
    "mbl_ng_ml": {
      "type": "number",
      "description": "Mannose-binding lectin (MBL), ng/mL",
      "domain": "medical"
    },
    "il6_pg_ml": {
      "type": "number",
      "description": "Interleukin-6 (IL-6), pg/mL",
      "domain": "medical"
    },
    "tnfa_pg_ml": {
      "type": "number",
      "description": "Tumor necrosis factor alpha (TNF-α), pg/mL",
      "domain": "medical"
    },
    "il1b_pg_ml": {
      "type": "number",
      "description": "Interleukin-1β, pg/mL",
      "domain": "medical"
    },
    "il17_pg_ml": {
      "type": "number",
      "description": "Interleukin-17, pg/mL",
      "domain": "medical"
    },
    "tsh_u_u_ml": {
      "type": "number",
      "description": "TSH, µU/mL",
      "domain": "medical"
    },
    "ft3_pg_ml": {
      "type": "number",
      "description": "Free T3, pg/mL",
      "domain": "medical"
    },
    "ft4_ng_dl": {
      "type": "number",
      "description": "Free T4, ng/dL",
      "domain": "medical"
    },
    "cortisol_morning_ug_dl": {
      "type": "number",
      "description": "Morning serum cortisol, µg/dL",
      "domain": "medical"
    },
    "vitd25_oh_ng_ml": {
      "type": "number",
      "description": "25-OH vitamin D, ng/mL",
      "domain": "medical"
    },
    "vitb12_pg_ml": {
      "type": "number",
      "description": "Vitamin B12, pg/mL",
      "domain": "medical"
    },
    "folate_ng_ml": {
      "type": "number",
      "description": "Folate, ng/mL",
      "domain": "medical"
    },
    "lab_values_json": {
      "type": "string",
      "description": "Raw lab results as JSON string (for parameters without dedicated fields)",
      "domain": "medical"
    },
    "lab_abnormal_flags_json": {
      "type": "string",
      "description": "JSON string: parameter → {value, unit, reference_range, direction}",
      "domain": "medical"
    },

    "contract_parties": {
      "type": "array",
      "itemType": "string",
      "description": "Parties to the contract",
      "domain": "legal"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date",
      "description": "Contract start date",
      "domain": "legal"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date",
      "description": "Contract end date",
      "domain": "legal"
    },
    "contract_value": {
      "type": "number",
      "description": "Contract monetary value",
      "domain": "legal"
    },
    "termination_notice": {
      "type": "string",
      "description": "Termination notice period",
      "domain": "legal"
    },
    "case_number": {
      "type": "string",
      "description": "Case/file number (separate from generic reference)",
      "domain": "legal"
    },
    "deadline_date": {
      "type": "string",
      "format": "date",
      "description": "Legal deadline date",
      "domain": "legal"
    },

    "product_name": {
      "type": "string",
      "description": "Product/device name",
      "domain": "technical"
    },
    "model_number": {
      "type": "string",
      "description": "Model/part number",
      "domain": "technical"
    },
    "serial_number": {
      "type": "string",
      "description": "Serial number",
      "domain": "technical"
    },
    "manufacturer": {
      "type": "string",
      "description": "Manufacturer name",
      "domain": "technical"
    },
    "specifications": {
      "type": "object",
      "description": "Technical specifications as key-value pairs",
      "domain": "technical"
    },

    "sender_address": {
      "type": "string",
      "description": "Sender postal address",
      "domain": "personal"
    },
    "recipient_address": {
      "type": "string",
      "description": "Recipient postal address",
      "domain": "personal"
    },
    "reference_number": {
      "type": "string",
      "description": "Reference/case number",
      "domain": "personal"
    }
  }
}
