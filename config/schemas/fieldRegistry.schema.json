{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Field Registry Schema",
  "type": "object",
  "required": [
    "_version",
    "_description",
    "fields",
    "domainMappings"
  ],
  "properties": {
    "_version": { "type": "string" },
    "_description": { "type": "string" },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "domainMappings": {
      "type": "object",
      "required": ["financial", "medical", "legal", "general"],
      "properties": {
        "financial": { "$ref": "#/$defs/domainMapping" },
        "medical": { "$ref": "#/$defs/domainMapping" },
        "legal": { "$ref": "#/$defs/domainMapping" },
        "general": { "$ref": "#/$defs/domainMapping" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "domainMapping": {
      "type": "object",
      "required": [
        "requiredFields",
        "optionalFields",
        "expertModel",
        "displayName",
        "icon"
      ],
      "properties": {
        "requiredFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "optionalFields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expertModel": { "type": "string" },
        "displayName": {
          "type": "object",
          "required": ["en", "de"],
          "properties": {
            "en": { "type": "string" },
            "de": { "type": "string" }
          },
          "additionalProperties": true
        },
        "icon": { "type": "string" }
      },
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": [
        "type",
        "domain",
        "paperlessField",
        "visualLabels",
        "extractionPriority",
        "validationRules",
        "displayName"
      ],
      "properties": {
        "type": { "type": "string" },
        "domain": { "type": "string" },
        "paperlessField": {
          "type": "string",
          "pattern": "^(metadata|custom_field):"
        },
        "visualLabels": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "extractionPriority": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validationRules": { "type": "object" },
        "displayName": {
          "type": "object",
          "required": ["en", "de"],
          "properties": {
            "en": { "type": "string" },
            "de": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
