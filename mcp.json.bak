{
    "mcpServers": {
        "context7": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@upstash/context7-mcp@latest"
            ]
        },
        "sequential-thinking": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ]
		},
		"oraios/serena": {
			"type": "sse",
			"url": "http://127.0.0.1:9121/sse"
		},
        "windows-mcp": {
            "type": "stdio",
            "command": "uv",
            "args": [
                "--directory",
                "C:\\Users\\pwalc\\Downloads\\Windows-MCP",
                "run",
                "main.py"
            ],
            "env": {
                "PYTHONPATH": "C:\\Users\\pwalc\\Downloads\\Windows-MCP\\src",
                "PYTHONUNBUFFERED": "1",
                "PYTHONNOUSERSITE": "1",
                "PYTHONIOENCODING": "utf-8"
            }
        },
        "github/github-mcp-server": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "gallery": "https://api.mcp.github.com/2025-09-15/v0/servers/ab12cd34-5678-90ef-1234-567890abcdef",
            "version": "0.13.0"
        }
    },
    "inputs": [
        {
            "id": "codacy_account_token",
            "type": "promptString",
            "description": "Codacy Account Token for API access",
            "password": true
        }
    ]
}