{
	"mcpServers": {
		"context7": {
			"url": "https://mcp.context7.com/mcp",
			"type": "http"
		},
		"sequential-thinking": {
			"type": "stdio",
			"command": "cmd",
			"args": [
				"/c",
				"npx",
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			]
		},
		"oraios-serena": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"serena==latest",
				"--context",
				"ide-assistant"
			],
			"gallery": "https://api.mcp.github.com/2025-09-15/v0/servers/0658e342-7ae7-493a-b378-a324363ee322",
			"version": "1.0.0"
		},
		"windows-mcp": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"--directory",
				"C:\\Users\\pwalc\\Downloads\\Windows-MCP",
				"run",
				"main.py"
			],
			"env": {
				"PYTHONPATH": "C:\\Users\\pwalc\\Downloads\\Windows-MCP\\src",
				"PYTHONUNBUFFERED": "1",
				"PYTHONNOUSERSITE": "1",
				"PYTHONIOENCODING": "utf-8"
			}
		},
		"github/github-mcp-server": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"gallery": "https://api.mcp.github.com/2025-09-15/v0/servers/ab12cd34-5678-90ef-1234-567890abcdef",
			"version": "0.13.0"
		},
		"awesome-copilot": {
			"type": "stdio",
			"command": "docker",
			"args": [
				"run",
				"-i",
				"--rm",
				"ghcr.io/microsoft/mcp-dotnet-samples/awesome-copilot:latest"
			]
		}
	},
	"inputs": [
		{
			"id": "codacy_account_token",
			"type": "promptString",
			"description": "Codacy Account Token for API access",
			"password": true
		}
	]
}