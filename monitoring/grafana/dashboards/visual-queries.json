  "panels": [
    {
      "title": "Visual Query Execution P95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, document_type) (rate(visual_query_execution_time_ms_bucket[5m])))",
          "legendFormat": "{{document_type}}"
        }
      ]
    },
    {
      "title": "Visual Queries Executed (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(visual_queries_executed_total[5m])) by (query_type)",
          "legendFormat": "{{query_type}}"
        }
      ]
    },
    {
      "title": "Embedding Query Latency P95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, query_type) (rate(embedding_query_latency_ms_bucket[5m])))",
          "legendFormat": "{{query_type}}"
        }
      ]
    },
    {
      "title": "Visual Confirmation Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "visual_confirmation_rate",
          "legendFormat": "{{document_type}}"
        }
      ]
    }
  ],
