  "panels": [
    {
      "title": "Pipeline Stage Latency P95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage_name) (rate(pipeline_stage_latency_ms_bucket[5m])))",
          "legendFormat": "{{stage_name}}"
        }
      ]
    },
    {
      "title": "OCR Conflict Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "ocr_reconciliation_conflict_rate",
          "legendFormat": "{{document_type}}"
        }
      ]
    },
    {
      "title": "Sidecar Availability",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sidecar_availability",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Circuit Breaker State",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "circuit_breaker_state",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "OCR Source Attribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "ocr_source_attribution_rate",
          "legendFormat": "{{document_type}}/{{source}}"
        }
      ]
    }
  ],
