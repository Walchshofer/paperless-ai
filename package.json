{
  "name": "paperless-ai",
  "version": "1.0.0",
  "description": "AI based Tag, correspondent and meta data generation",
  "main": "server.js",
  "scripts": {
    "test": "mocha --require test/setup-env.js test/**/*.{test,spec}.js --timeout 30000 --reporter spec --exit",
    "test:integration": "cross-env GUIDANCE_ENABLED=true GUIDANCE_SERVICE_ENABLED=yes RAG_SERVICE_ENABLED=true mocha --require test/setup-env.js test/**/*.{test,spec}.js --timeout 60000 --reporter spec",
    "test:performance": "mocha --require test/setup-env.js \"test/performance/**/*.{test,spec}.js\" --timeout 60000 --reporter spec --exit",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "test:report": "node scripts/test-report.js",
    "test:ui": "vitest",
    "test:ui:e2e": "npx playwright test test/e2e/shadcn-compat.spec.ts --config=test/playwright.config.ts",
    "test:ui:e2e:report": "npx playwright test test/e2e/shadcn-compat.spec.ts --config=test/playwright.config.ts --reporter=html && node scripts/collect-playwright-report.js",
    "verification:fast": "node scripts/check-db-schema.js && node scripts/check-islands.js && npm test",
    "verification:e2e": "npx playwright test --config=test/playwright.config.ts",
    "verification:e2e:report": "npx playwright show-report test-results/playwright-report",
    "verification:e2e:ui": "npx playwright test --ui --config=test/playwright.config.ts",
    "dev": "node scripts/dev-server.js",
    "build:islands": "vite build --config vite.config.ts",
    "build:css": "tailwindcss -i src/styles/tailwind-input.css -o public/css/tailwind.css --minify",
    "check:island-runtime": "node scripts/check-island-runtime.js",
    "env:sync": "bash scripts/sync_dotenv_from_compose_env.sh || pwsh -NoProfile -File scripts/sync_dotenv_from_compose_env.ps1",
    "env:validate": "python scripts/validate_env_py.py"
  },
  "keywords": [
    "paperless-ngx",
    "ai",
    "paperless",
    "artificial",
    "intelligence"
  ],
  "nodemonConfig": {
    "ignore": [
      "test/*",
      "docs/*",
      "node_modules/*",
      ".git/*",
      "*.log",
      "public/*",
      "views/*",
      "document.json",
      "OPENAPI/openapi.json"
    ]
  },
  "author": "Clusterzx",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "1.16.2",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "body-parser": "^1.20.3",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dockerode": "^4.0.6",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jsonrepair": "^3.13.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemon": "^3.1.9",
    "openai": "^4.86.2",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.3",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "rimraf": "^6.0.1",
    "sharp": "^0.33.5",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tiktoken": "^1.0.20",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@grpc/grpc-js": "^1.11.5",
    "@grpc/proto-loader": "^0.7.13",
    "@playwright/test": "^1.43.0",
    "@preact/preset-vite": "^2.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@testing-library/preact": "^3.2.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "autoprefixer": "^10.4.14",
    "c8": "^9.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsdoc": "^50.6.3",
    "globals": "^16.0.0",
    "jsdom": "^22.1.0",
    "mocha": "^11.7.5",
    "postcss": "^8.4.24",
    "preact": "^10.28.2",
    "prettier": "^3.5.3",
    "supertest": "^6.3.3",
    "tailwind-merge": "^1.14.0",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "vitest": "^1.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@scarf/scarf",
      "better-sqlite3"
    ]
  }
}
